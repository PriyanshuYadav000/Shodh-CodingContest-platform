APP_NAME=Shodh Coding Contest Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_DB=shodh_db
POSTGRES_USER=shodh_user
POSTGRES_PASSWORD=replace_with_local_password

DATABASE_URL=postgresql+psycopg://shodh_user:replace_with_local_password@127.0.0.1:5433/shodh_db

JWT_SECRET_KEY=replace_with_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
